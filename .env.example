# ABNA PICKS Environment Configuration
# Copy this file to .env and provide your project values.
# NEVER commit real secrets or production service role keys to source control.

# Public Browser Configuration (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-Only Configuration (Never exposed to browser bundles)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional 3rd-party Services
LOVABLE_API_KEY=your_lovable_api_key_here
